DATABASE_URL=postgresql://USER@localhost:5432/shopping-mcp
SESSION_SECRET=change-me-to-a-long-random-string
CREDENTIALS_KEY=change-me-to-a-different-long-random-string
API_PORT=3001
BETTER_AUTH_SECRET=change-me-to-a-third-long-random-string
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_ORIGIN=http://localhost:3001
# External MCP / production-like testing over the tunnel: set API_ORIGIN, WEB_ORIGIN and
# NEXT_PUBLIC_API_ORIGIN to the HTTPS hostnames and COOKIE_DOMAIN to their parent domain.
SHOPIFY_API_KEY=
SHOPIFY_SCOPES=read_products
SHOPIFY_REDIRECT_URI=http://127.0.0.1:3001/api/connections/shopify/callback
SHOPIFY_API_SECRET=
