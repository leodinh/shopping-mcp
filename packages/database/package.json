{
  "name": "@shopping-mcp/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --max-warnings=0 --fix"
  },
  "dependencies": {
    "@shopping-mcp/config": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
