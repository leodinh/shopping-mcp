{
  "name": "shopping-mcp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm run --parallel --filter @shopping-mcp/web --filter @shopping-mcp/api --filter @shopping-mcp/worker dev",
    "dev:web": "pnpm --filter @shopping-mcp/web dev",
    "dev:api": "pnpm --filter @shopping-mcp/api dev",
    "dev:worker": "pnpm --filter @shopping-mcp/worker dev",
    "build": "pnpm --filter @shopping-mcp/web --filter @shopping-mcp/api --filter @shopping-mcp/worker build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "db:migrate": "pnpm --filter @shopping-mcp/database migrate",
    "db:setup": "pnpm run db:migrate",
    "db:generate": "pnpm --filter @shopping-mcp/database generate",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --env-file-if-exists=.env --test tests/integration/*.test.ts"
  },
  "devDependencies": {
    "@shopping-mcp/api": "workspace:*",
    "@shopping-mcp/application": "workspace:*",
    "@shopping-mcp/worker": "workspace:*",
    "@shopping-mcp/config": "workspace:*",
    "@shopping-mcp/contracts": "workspace:*",
    "@shopping-mcp/database": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "@types/supertest": "^6.0.3",
    "drizzle-orm": "^0.45.2",
    "pg": "8.23.0",
    "prettier": "^3.9.6",
    "supertest": "^7.1.4",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "zod": "4.5.4"
  }
}
