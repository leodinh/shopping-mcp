{
  "name": "@shopping-mcp/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --env-file-if-exists=../../.env src/main.ts",
    "start": "node --import tsx --env-file-if-exists=../../.env src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests --max-warnings=0",
    "lint:fix": "eslint src tests --max-warnings=0 --fix",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@shopping-mcp/commerce": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "tsx": "^4.0.0"
  }
}
