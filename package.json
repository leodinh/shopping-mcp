{
  "name": "shopping-mcp-commerce-core",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:setup": "npm run db:migrate",
    "sync": "tsx --env-file-if-exists=.env scripts/sync.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --env-file-if-exists=.env --test tests/integration/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "mcp-handler": "^2.1.1",
    "next": "16.3.4",
    "pg": "8.23.0",
    "postcss": "^8.5.28",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
